# ============ 本地运行必需 ============
# 在 https://tushare.pro/user/token 复制你的 token
TUSHARE_TOKEN=your_token_here

# ============ OpenAI AI 解读（部署时必填） ============
# 在 https://platform.openai.com/api-keys 创建 API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
